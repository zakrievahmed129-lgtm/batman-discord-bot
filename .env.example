# Token secret du bot Discord (obtenu sur https://discord.com/developers/applications)
DISCORD_TOKEN=colle_ton_token_discord_ici

# Port pour le serveur web interne Keep-Alive (automatique sur Render ou 8080 en local)
PORT=8080

# Clé API Google Gemini (gratuite sur https://aistudio.google.com/)
# Nécessaire pour :
# - L'intelligence artificielle (/ia avec mémoire et vision multimodale)
# - La génération d'images haute définition (/image et /imagine)
# - Le clonage de style et réponses automatiques (/mon_style et /reponds_pour_moi)
# - Le décodeur de sous-entendus et reformulations
GEMINI_API_KEY=colle_ta_cle_gemini_api_ici

